---
import { counterBoard, line, unknowns } from '../lib/facts.js';
const { exhibit } = Astro.props;
const doc = exhibit.document;
const board = counterBoard(doc);
const parts = line(doc);
const gaps = unknowns(doc);
---
<article class="exhibit" data-exhibit={exhibit.slug}>
  <header>
    <h3 data-exhibit={exhibit.slug}>{doc.product.title}</h3>
  </header>
  <dl class="board">
    {board.map((f) => (
      <div class={f.value === null ? 'fact not-recorded' : 'fact'}>
        <dt>{f.label}</dt>
        <dd>{f.value === null ? 'not recorded' : f.value}</dd>
      </div>
    ))}
  </dl>
  <ol class="line" aria-label="Pull requests along the line">
    {parts.map((p) => (
      <li class={p.landed ? 'part landed' : 'part'}>
        <span class="part-label">{p.label}</span>
        {p.stamps === null
          ? <span class="stamps not-recorded">stamps not recorded</span>
          : <span class="stamps">{Array.from({ length: p.stamps }, (_, i) => (
              <span class={i < p.rework ? 'stamp rework' : 'stamp pass'} title={i < p.rework ? 'sent back for rework' : 'passed inspection'}></span>
            ))}</span>}
      </li>
    ))}
  </ol>
  {gaps.length > 0 && <p class="gaps">Not recorded: {gaps.join(', ')}.</p>}
  {exhibit.has_bundle && (
    <p class="bundle">
      <a href={`/${exhibit.slug}/`}>Launch page</a> · <a href={`/${exhibit.slug}/how-it-was-built.html`}>How it was built</a>
    </p>
  )}
  <details class="verify">
    <summary>Verify this record</summary>
    <p>Snapshot v{exhibit.version}, published {exhibit.published_at}.</p>
    <p>content_sha256 <code>{exhibit.content_sha256}</code>, recomputed at build time.</p>
    <p><a href={`https://api.qontinui.io/api/v1/public/build-records/${exhibit.slug}`}>The public record</a></p>
  </details>
</article>
